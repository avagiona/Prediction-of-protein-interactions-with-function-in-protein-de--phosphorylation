                      dplyr::right_join(edges_hyper_net,by=c("A"="GeneID_A", "B"="GeneID_B"),keep=TRUE)

ppi_PSICQUIC_rest<-ppi_PSICQUIC %>% dplyr::select(c(1,2,12,16)) %>%
                   dplyr::filter(!(provider=="BioGrid")) %>% 
