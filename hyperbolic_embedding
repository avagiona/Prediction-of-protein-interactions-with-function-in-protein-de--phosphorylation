                   dplyr::mutate(B = stringr::str_remove_all(B, fixed("uniprotkb:"))) %>%
                   dplyr::right_join(edges_hyper_net,by=c("A"="UniProtKB_AC_A", "B"="UniProtKB_AC_B"),keep=TRUE)
