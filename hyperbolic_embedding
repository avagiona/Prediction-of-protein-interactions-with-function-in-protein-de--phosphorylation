#construct 0.71 network, estimatate parameters and embed----------------------------------
net_0.71<-edgelist %>% dplyr::filter(V5 >= 0.71)%>% 
                       dplyr::select (V1,V3)%>% 
                       igraph::graph_from_data_frame(directed = FALSE)%>%
                       igraph::simplify()
#get the LCC of 0.71 network
G_net_0.71<-decompose.graph(net_0.71)[[which.max(sapply(decompose.graph(net_0.71),vcount))]]
N_G_net_0.71<-data.frame(name = igraph::V(G_net_0.71)$name)
E_G_net_0.71<-igraph::E(G_net_0.71)
Edgelist_G_net_0.71<-as.data.frame(get.edgelist(G_net_0.71))
#parameters estimation
gma<-fit_power_law(degree(G_net_0.71))$alpha #gamma parameter
c<-transitivity(G_net_0.71,type ="localaverage")#clustering coefficient
avg_k<-mean(degree(G_net_0.71))#average node degree 
#----------------parameters estimation
#estimate Temperature
psmodels_0.71=list()
c_psmodels_0.71=list()
mean_c_psmodels_0.71=NULL
for (i in 1:10){
  psmodels_0.71[[i]]<-ps_model(N = 13077, avg.k = 14.24, gma = 2.74, Temp = 0)
  c_psmodels_0.71[[i]]<-transitivity(psmodels_0.71[[i]][["network"]],type = "localaverage")
  mean_c_psmodels_0.71<-(mean(c_psmodels_0.71[[i]]))
  return(mean_c_psmodels_0.71)
}
# Some maths by hand here, based on SF3 (LaBNE+HM paper) network 0.71
# when T=0, c=0.77
# when T=1, c=0 so the equation is: c=-0.77*T + 0.77
# when c=0.15 (clustering coefficient of the LCC), T=0.80
#apply LaBNE+HM 
#coordinates_giant_net_0.71<-labne_hm(G_net_0.71,gma = 2.74, Temp = 0.80, w = 2*pi)
#saveRDS(coordinates_giant_net_0.71,file="coordinates_0.71.RData")
Coord_G_net_0.71<-readRDS("coordinates_0.71.RData")

#evaluate the embedding to the hyperbolic disc------------------------------------
N <- vcount(G_net_0.71)
beta <- 1 / (gma - 1) # parameter controlling popularity fading
m <- round(avg_k/2) # parameter controlling average node degree
Temp=0.80
# Connection probability
conn <- get_conn_probs(G_net_0.71, Coord_G_net_0.71$polar, bins = 20)
theo <- get_theoretical_conn_probs(conn$dist, N, avg_k, gma, Temp)
conn <- rbind(conn, theo)
conn$label <- rep(c("LaBNE+HM", "Theory"), each = 20)
p_conn <- ggplot(conn, aes(dist, prob, colour = label, shape = label)) + 
  geom_point(size = 2) + geom_line() +
  scale_y_log10(breaks = scales::trans_breaks("log10", function(x) 10^x),
                labels = scales::trans_format("log10",scales::math_format(10^.x))) + 
  annotation_logticks(sides = "l") +
  scale_colour_manual(values = c("#339e2b", "#e3196a")) + 
  labs(x = "Hyperbolic distance", y = "Connection probability") + 
  theme_bw() + theme(legend.title = element_blank(), 
                     legend.background = element_blank(), 
                     legend.justification = c(0, 0), legend.position = c(0, 0))
p_conn
#ggexport(p_conn,filename = "p_conn.jpeg",width = 3200,height = 2500,pointsize = 7,res = 400)

# Real degrees vs expected degrees
degs <- tibble(k = degree(G_net_0.71), exp_k = numeric(N))
R <- 2*log(N) - 
  2*log((2*Temp*(1 - exp(-0.5*(1 - beta)*2*log(N))))/(sin(Temp*pi)*m*(1 - beta)))
for(i in 1:N){
  # Compute the hyperbolic distance between a node and all others
  d <- hyperbolic_dist(Coord_G_net_0.71$polar[i, ], Coord_G_net_0.71$polar)
  # Compute the probability that the node will connect with all others
  prob <- 1 / (1 + exp((d - R)/(2*Temp)))
  # Compute the expected node degree
  degs$exp_k[i] <- sum(prob)
}
p_deg <- ggplot(degs, aes(k, round(exp_k))) + geom_point(size = 0.2) +
  scale_x_log10(breaks = scales::trans_breaks("log10", function(x) 10^x), 
                labels = scales::trans_format("log10", scales::math_format())) +
  scale_y_log10(breaks = scales::trans_breaks("log10", function(x) 10^x), 
                labels = scales::trans_format("log10", scales::math_format())) +
  annotation_logticks() + labs(x = "Node degree", y = "Expected node degree") + 
  theme_bw()
p_deg
#ggexport(p_deg,filename = "p_deg.jpeg",width = 3200,height = 2500,pointsize = 7,res = 400)

# Clustering
epochs <- 10
cc <- transitivity(G_net_0.71, "average")
theo_cc <- numeric(epochs)
#it was runnign 5 days
for(i in 1:epochs){
  ps_net <- ps_model(N = N, avg.k = avg_k, gma = gma, Temp = Temp)
  theo_cc[i] <- transitivity(ps_net$network, "average")
}
